#: .\apps\bookings\services.py:98 .\apps\bookings\services.py:262
msgid "This hold token is for a different trip."
msgstr "កូដកាន់កាប់កៅអីនេះសម្រាប់ដំណើរផ្សេង។"

#: .\apps\bookings\services.py:103
#, python-format
msgid "%(passengers)s passengers given for %(seats)s held seats."
msgstr "មានអ្នកដំណើរ %(passengers)s នាក់ ប៉ុន្តែមានកៅអីដែលបានកាន់កាប់ %(seats)s កៅអី។"

#: .\apps\bookings\services.py:160 .\apps\payments\services.py:67
#, python-format
msgid "Booking %(pnr)s is %(status)s, not pending_payment."
msgstr "ការកក់ %(pnr)s មានស្ថានភាព %(status)s មិនមែនកំពុងរង់ចាំបង់ប្រាក់ទេ។"

#: .\apps\bookings\services.py:204
#, python-format
msgid "Booking %(pnr)s is %(status)s and cannot be cancelled."
msgstr "ការកក់ %(pnr)s មានស្ថានភាព %(status)s ហើយមិនអាចលុបចោលបានទេ។"

#: .\apps\bookings\services.py:256
#, python-format
msgid "Booking %(pnr)s is %(status)s and cannot be rescheduled."
msgstr "ការកក់ %(pnr)s មានស្ថានភាព %(status)s ហើយមិនអាចប្តូរកាលវិភាគបានទេ។"

#: .\apps\bookings\services.py:268
#, python-format
msgid "%(seats)s held seats for %(passengers)s existing passengers."
msgstr ""
"មានកៅអីដែលបានកាន់កាប់ %(seats)s កៅអី សម្រាប់អ្នកដំណើរដែលមានស្រាប់ %(passengers)s នាក់។"

#: .\apps\payments\services.py:89
msgid "Only pay-at-counter payments can be marked paid this way."
msgstr "មានតែការបង់ប្រាក់នៅកន្លែងលក់សំបុត្រប៉ុណ្ណោះដែលអាចសម្គាល់ថាបានបង់តាមវិធីនេះ។"

#: .\apps\payments\services.py:91
#, python-format
msgid "Payment is already %(status)s."
msgstr "ការបង់ប្រាក់នេះមានស្ថានភាព %(status)s រួចហើយ។"

#: .\apps\payments\services.py:179
msgid "Only a succeeded payment can be refunded."
msgstr "មានតែការបង់ប្រាក់ដែលបានជោគជ័យប៉ុណ្ណោះដែលអាចសង​វិញបាន។"

#: .\apps\payments\services.py:186
#, python-format
msgid "Refund amount must be between 0 and %(remaining)s."
msgstr "ចំនួនទឹកប្រាក់សងវិញត្រូវនៅចន្លោះ ០ និង %(remaining)s។"

#: .\apps\payments\services.py:220
#, python-format
msgid "Promo code '%(code)s' does not exist or is inactive."
msgstr "កូដប្រូម៉ូសិន '%(code)s' មិនមាន ឬមិនដំណើរការទេ។"

#: .\apps\payments\services.py:225
#, python-format
msgid "Promo code '%(code)s' is not currently valid."
msgstr "កូដប្រូម៉ូសិន '%(code)s' មិនមានសុពលភាពនៅពេលនេះទេ។"

#: .\apps\payments\services.py:229
#, python-format
msgid "Promo code '%(code)s' requires a minimum of %(min_amount)s."
msgstr "កូដប្រូម៉ូសិន '%(code)s' តម្រូវឱ្យមានចំនួនអប្បបរមា %(min_amount)s។"

#: .\apps\payments\services.py:236
#, python-format
msgid "Promo code '%(code)s' does not apply to this operator."
msgstr "កូដប្រូម៉ូសិន '%(code)s' មិនអាចប្រើជាមួយក្រុមហ៊ុននេះបានទេ។"

#: .\apps\payments\services.py:240
#, python-format
msgid "Promo code '%(code)s' does not apply to this route."
msgstr "កូដប្រូម៉ូសិន '%(code)s' មិនអាចប្រើជាមួយផ្លូវនេះបានទេ។"

#: .\apps\payments\services.py:246
#, python-format
msgid "Promo code '%(code)s' has reached its usage limit."
msgstr "កូដប្រូម៉ូសិន '%(code)s' បានប្រើដល់កម្រិតកំណត់ហើយ។"

#: .\apps\payments\services.py:416
msgid "The period end must not be before its start."
msgstr "កាលបរិច្ឆេទបញ្ចប់មិនអាចមុនកាលបរិច្ឆេទចាប់ផ្តើមបានទេ។"

#: .\apps\payments\services.py:428
#, python-format
msgid ""
"Payout must be between 0 and the %(outstanding)s %(currency)s outstanding."
msgstr "ចំនួនទូទាត់ត្រូវនៅចន្លោះ ០ និង %(outstanding)s %(currency)s ដែលនៅសល់។"

#: .\apps\trips\services.py:102
#, python-format
msgid "Trip %(trip_id)s is busy — try again."
msgstr "ដំណើរ %(trip_id)s កំពុងរវល់ — សូមព្យាយាមម្តងទៀត។"

#: .\apps\trips\services.py:191
#, python-format
msgid "This trip is %(status)s and can no longer be booked."
msgstr "ដំណើរនេះមានស្ថានភាព %(status)s ហើយលែងអាចកក់បានទៀតហើយ។"

#: .\apps\trips\services.py:194
msgid "This trip has already departed."
msgstr "ដំណើរនេះបានចេញដំណើរទៅហើយ។"

#: .\apps\trips\services.py:197
msgid "This trip's seat map is out of date. Please contact support to book it."
msgstr "ផែនទីកៅអីរបស់ដំណើរនេះហួសសម័យ។ សូមទាក់ទងផ្នែកជំនួយដើម្បីកក់ដំណើរនេះ។"

#: .\apps\trips\services.py:216
msgid "Arrival must be after departure."
msgstr "ពេលវេលាមកដល់ត្រូវក្រោយពេលវេលាចេញដំណើរ។"

#: .\apps\trips\services.py:219
#, python-format
msgid "Bus %(plate_number)s is %(status)s and cannot be scheduled."
msgstr ""
"រថយន្តក្រុងស្លាកលេខ %(plate_number)s មានស្ថានភាព %(status)s "
"ហើយមិនអាចកំណត់កាលវិភាគបានទេ។"

#: .\apps\trips\services.py:245
#, python-format
msgid "A %(status)s trip cannot be edited."
msgstr "ដំណើរដែលមានស្ថានភាព %(status)s មិនអាចកែសម្រួលបានទេ។"

#: .\apps\trips\services.py:291
msgid "End date must not be before start date."
msgstr "កាលបរិច្ឆេទបញ្ចប់មិនអាចមុនកាលបរិច្ឆេទចាប់ផ្តើមបានទេ។"

#: .\apps\trips\services.py:293
msgid "Duration must be positive."
msgstr "រយៈពេលត្រូវតែធំជាងសូន្យ។"

#: .\apps\trips\services.py:305
#, python-format
msgid "At most %(max)s trips can be created at once."
msgstr "អាចបង្កើតដំណើរបានច្រើនបំផុត %(max)s ដំណើរក្នុងពេលតែមួយ។"

#: .\apps\trips\services.py:347
msgid "No dates in that range match the chosen weekdays."
msgstr "គ្មានកាលបរិច្ឆេទណាមួយក្នុងចន្លោះនោះត្រូវនឹងថ្ងៃដែលបានជ្រើសរើសទេ។"

#: .\apps\trips\services.py:398
msgid "This hold token is invalid or has been tampered with."
msgstr "កូដកាន់កាប់កៅអីនេះមិនត្រឹមត្រូវ ឬត្រូវបានកែប្រែ។"

#: .\apps\trips\services.py:403
msgid "This seat hold has expired."
msgstr "ការកាន់កាប់កៅអីនេះបានផុតកំណត់ហើយ។"

#: .\apps\trips\services.py:577
#, python-format
msgid "This trip is already %(status)s."
msgstr "ដំណើរនេះមានស្ថានភាព %(status)s រួចហើយ។"

#: .\apps\trips\services.py:579
msgid "Only a delayed trip can be marked back on time."
msgstr "មានតែដំណើរដែលយឺតយ៉ាវប៉ុណ្ណោះដែលអាចសម្គាល់ថាត្រលប់មកទាន់ពេលវិញ។"
